{% extends 'base.html.twig' %}

{% block title %}Mes réservations{% endblock %}

{#
    Écran E5 (US5), d'après la maquette. Couleurs des statuts : celles de la charte
    (confirmée = réservé, en cours = sorti, terminée = disponible, annulée = neutre).
#}
{% set classes_statut = {
    confirmee: 'badge-reserve',
    en_cours: 'badge-sorti',
    terminee: 'badge-disponible',
    annulee: 'badge-neutre',
} %}

{% block body %}
    {% embed '_partials/entete_page.html.twig' with {
        titre: 'Mes réservations',
        sous_titre: actives ~ ' réservation' ~ (actives > 1 ? 's') ~ ' active' ~ (actives > 1 ? 's') ~ ' sur ' ~ quota ~ ' autorisées',
    } %}
        {% block actions %}
            <a href="{{ path('app_catalogue') }}" class="bouton bouton-accent">Réserver un objet</a>
        {% endblock %}
    {% endembed %}

    {% if reservations is empty %}
        {{ include('_partials/etat_vide.html.twig', {
            message: 'Vous n\'avez encore aucune réservation. Choisissez un objet dans le catalogue pour commencer.',
            lien: {url: path('app_catalogue'), texte: 'Voir le catalogue'},
        }) }}
    {% else %}
        <div class="cadre-tableau mt-6" role="region" aria-label="Mes réservations" tabindex="0">
            <table class="tableau">
                <caption class="sr-only">Mes réservations, des plus proches aux plus anciennes</caption>
                <thead class="tableau-entete">
                    <tr>
                        <th scope="col" class="cellule-entete">Objet</th>
                        <th scope="col" class="cellule-entete">Du</th>
                        <th scope="col" class="cellule-entete">Au</th>
                        <th scope="col" class="cellule-entete">Statut</th>
                        <th scope="col" class="cellule-entete">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    {% for reservation in reservations %}
                        {% set objet = reservation.objet %}
                        <tr>
                            {# En-tête de ligne : le lecteur d'écran annonce l'objet avec chaque cellule #}
                            <th scope="row" class="cellule font-normal">
                                {% if objet.actif %}
                                    <a href="{{ path('app_catalogue_objet', {id: objet.id}) }}" class="lien font-normal">{{ objet.nom }}</a>
                                {% else %}
                                    {{ objet.nom }}
                                {% endif %}
                            </th>
                            <td class="cellule">{{ reservation.dateDebut|date('d/m/Y') }}</td>
                            <td class="cellule">{{ reservation.dateFin|date('d/m/Y') }}</td>
                            <td class="cellule">
                                <span class="badge {{ classes_statut[reservation.statut.value] }}">{{ reservation.statut.libelle }}</span>
                            </td>
                            <td class="cellule">
                                {% if is_granted('RESERVATION_ANNULER', reservation) %}
                                    <form method="post" action="{{ path('app_mes_reservations_annuler', {id: reservation.id}) }}"
                                          data-confirmation="Annuler la réservation de « {{ objet.nom }} » ?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('annuler-reservation-' ~ reservation.id) }}">
                                        <button type="submit" class="bouton-ligne bouton-danger"
                                                aria-label="Annuler la réservation : {{ objet.nom }}, du {{ reservation.dateDebut|date('d/m/Y') }} au {{ reservation.dateFin|date('d/m/Y') }}">
                                            Annuler
                                        </button>
                                    </form>
                                {% elseif reservation.statut.value == 'confirmee' %}
                                    <span class="text-ink-muted">Annulation impossible à partir du premier jour</span>
                                {% elseif reservation.estEnRetardLe(aujourdhui) %}
                                    <span class="font-semibold text-danger">Retour en retard : à rendre le {{ reservation.dateFin|date('d/m/Y') }} au plus tard</span>
                                {% elseif reservation.statut.value == 'en_cours' %}
                                    Sortie validée le {{ reservation.sortieLe|date('d/m/Y') }}
                                {% elseif reservation.statut.value == 'terminee' %}
                                    Rendu {{ reservation.etatRetour.value == 'bon' ? 'en bon état' : (reservation.etatRetour.value == 'abime' ? 'abîmé' : 'hors service') }}
                                {% else %}
                                    <span class="text-ink-muted">Aucune action</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
