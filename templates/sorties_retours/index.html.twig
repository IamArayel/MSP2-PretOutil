{% extends 'base.html.twig' %}

{% block title %}Sorties et retours{% endblock %}

{# Écran E6, d'après la maquette e6-sorties-retours.png. Composants communs à E6-E9 : assets/styles/app.css #}
{% block body %}
    {% set jours = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'] %}
    {% set mois = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}

    {{ include('_partials/entete_page.html.twig', {
        titre: 'Sorties et retours',
        sous_titre: jours[aujourdhui|date('w')]|capitalize ~ ' ' ~ aujourdhui|date('j') ~ ' ' ~ mois[aujourdhui|date('n') - 1] ~ ' ' ~ aujourdhui|date('Y'),
    }) }}

    {# US7 : sorties à valider #}
    <section class="mt-8" aria-labelledby="sorties-titre">
        <h2 id="sorties-titre" class="text-xl font-semibold">À sortir aujourd'hui ({{ sorties|length }})</h2>

        {# Cadre défilant sur mobile : atteignable au clavier pour faire défiler le tableau #}
        <div class="cadre-tableau" role="region" aria-labelledby="sorties-titre" tabindex="0">
            <table class="tableau">
                <caption class="sr-only">Sorties à valider aujourd'hui</caption>
                <thead class="tableau-entete">
                    <tr>
                        <th scope="col" class="cellule-entete">Objet</th>
                        <th scope="col" class="cellule-entete">Adhérent</th>
                        <th scope="col" class="cellule-entete">Période</th>
                        <th scope="col" class="cellule-entete">Statut</th>
                        <th scope="col" class="cellule-entete">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    {% for reservation in sorties %}
                        {% set adherent = reservation.utilisateur.prenom ~ ' ' ~ reservation.utilisateur.nom %}
                        <tr>
                            <th scope="row" class="cellule font-normal">{{ reservation.objet.nom }}</th>
                            <td class="cellule">{{ adherent }}</td>
                            <td class="cellule whitespace-nowrap">{{ reservation.dateDebut|date('d/m') }} au {{ reservation.dateFin|date('d/m/Y') }}</td>
                            <td class="cellule"><span class="badge badge-reserve">{{ reservation.statut.libelle }}</span></td>
                            <td class="cellule">
                                <form method="post" action="{{ path('app_sorties_retours_sortie', {id: reservation.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('sortie-reservation-' ~ reservation.id) }}">
                                    <button type="submit" class="bouton-ligne bouton-primaire"
                                            aria-label="Valider la sortie : {{ reservation.objet.nom }}, {{ adherent }}">
                                        Valider la sortie
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="cellule-vide">Aucune sortie à valider aujourd'hui.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {# US8 : retours attendus, retards en premier #}
    <section class="mt-10" aria-labelledby="retours-titre">
        <h2 id="retours-titre" class="text-xl font-semibold">Retours attendus ({{ retours|length }})</h2>

        <div class="cadre-tableau" role="region" aria-labelledby="retours-titre" tabindex="0">
            <table class="tableau">
                <caption class="sr-only">Retours attendus, retards en premier</caption>
                <thead class="tableau-entete">
                    <tr>
                        <th scope="col" class="cellule-entete">Objet</th>
                        <th scope="col" class="cellule-entete">Adhérent</th>
                        <th scope="col" class="cellule-entete">Période</th>
                        <th scope="col" class="cellule-entete">Statut</th>
                        <th scope="col" class="cellule-entete">État au retour</th>
                        <th scope="col" class="cellule-entete">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    {% for reservation in retours %}
                        {% set formulaire = 'retour-' ~ reservation.id %}
                        {% set adherent = reservation.utilisateur.prenom ~ ' ' ~ reservation.utilisateur.nom %}
                        <tr>
                            <th scope="row" class="cellule font-normal">{{ reservation.objet.nom }}</th>
                            <td class="cellule">{{ adherent }}</td>
                            <td class="cellule whitespace-nowrap">{{ reservation.dateDebut|date('d/m') }} au {{ reservation.dateFin|date('d/m/Y') }}</td>
                            <td class="cellule">
                                {% if reservation.estEnRetardLe(aujourdhui) %}
                                    <span class="badge badge-hors-service">En retard</span>
                                {% else %}
                                    <span class="badge badge-sorti">{{ reservation.statut.libelle }}</span>
                                {% endif %}
                            </td>
                            <td class="cellule">
                                <label for="etat-{{ reservation.id }}" class="sr-only">État de {{ reservation.objet.nom }} au retour</label>
                                {# État actuel de l'objet proposé par défaut #}
                                <select id="etat-{{ reservation.id }}" name="etat" form="{{ formulaire }}" class="liste-choix">
                                    {% for etat in etats %}
                                        <option value="{{ etat.value }}"{% if etat == reservation.objet.etat %} selected{% endif %}>{{ etat.libelle }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td class="cellule">
                                <form id="{{ formulaire }}" method="post" action="{{ path('app_sorties_retours_retour', {id: reservation.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('retour-reservation-' ~ reservation.id) }}">
                                    <button type="submit" class="bouton-ligne bouton-primaire"
                                            aria-label="Enregistrer le retour : {{ reservation.objet.nom }}, {{ adherent }}">
                                        Enregistrer le retour
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="cellule-vide">Aucun retour attendu.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <p class="mt-4 text-xs text-ink-muted">
            État possible au retour : Bon, Abîmé, Hors service. « Hors service » rend l'objet indisponible à la réservation (RG7) ; ses réservations à venir sont signalées, pas annulées.
        </p>
    </section>
{% endblock %}
