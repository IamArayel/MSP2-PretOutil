{#
    Thème des formulaires Symfony : composants champ et champ-erreur de la charte (assets/styles/app.css).
    Déclaré dans config/packages/twig.yaml : tous les formulaires l'utilisent.
#}
{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="mb-4">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_label %}
    {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' block text-sm font-medium')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block form_widget_simple %}
    {% if type|default('text') == 'hidden' %}
        {{ parent() }}
    {% else %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' champ' ~ (errors|length > 0 ? ' champ-erreur' : ''))|trim}) %}
    {# Aide et erreurs reliées au champ, lues avec l'étiquette (RGAA 11.10) ; Symfony le fait dans son form_row, que ce thème remplace #}
    {% set decrit_par = (help is not empty ? [id ~ '_help'] : [])|merge(errors|length > 0 ? [id ~ '_erreurs'] : []) %}
    {% if decrit_par is not empty %}
        {% set attr = attr|merge({'aria-describedby': decrit_par|join(' ')}) %}
    {% endif %}
    {% if errors|length > 0 %}
        {% set attr = attr|merge({'aria-invalid': 'true'}) %}
    {% endif %}
    {{ parent() }}
    {% endif %}
{% endblock %}

{# Classes communes aux listes déroulantes et zones de texte (E7) #}
{% block textarea_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' champ' ~ (errors|length > 0 ? ' champ-erreur' : ''))|trim}) %}
    {# Aide et erreurs reliées au champ, lues avec l'étiquette (RGAA 11.10) ; Symfony le fait dans son form_row, que ce thème remplace #}
    {% set decrit_par = (help is not empty ? [id ~ '_help'] : [])|merge(errors|length > 0 ? [id ~ '_erreurs'] : []) %}
    {% if decrit_par is not empty %}
        {% set attr = attr|merge({'aria-describedby': decrit_par|join(' ')}) %}
    {% endif %}
    {% if errors|length > 0 %}
        {% set attr = attr|merge({'aria-invalid': 'true'}) %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' champ' ~ (errors|length > 0 ? ' champ-erreur' : ''))|trim}) %}
    {# Aide et erreurs reliées au champ, lues avec l'étiquette (RGAA 11.10) ; Symfony le fait dans son form_row, que ce thème remplace #}
    {% set decrit_par = (help is not empty ? [id ~ '_help'] : [])|merge(errors|length > 0 ? [id ~ '_erreurs'] : []) %}
    {% if decrit_par is not empty %}
        {% set attr = attr|merge({'aria-describedby': decrit_par|join(' ')}) %}
    {% endif %}
    {% if errors|length > 0 %}
        {% set attr = attr|merge({'aria-invalid': 'true'}) %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block form_help %}
    {% if help is not empty %}
        <p id="{{ id }}_help" class="mt-1 text-xs text-ink-muted">{{ help }}</p>
    {% endif %}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul id="{{ id }}_erreurs" class="mt-1 text-sm font-medium text-danger">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
