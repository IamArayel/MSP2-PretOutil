{#
    Thème des formulaires Symfony aux couleurs de la maquette (champ de l'écran E1).
    Déclaré dans config/packages/twig.yaml : tous les formulaires l'utilisent.
#}
{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="mb-4">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_label %}
    {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' block text-sm font-medium')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block form_widget_simple %}
    {% if type|default('text') == 'hidden' %}
        {{ parent() }}
    {% else %}
    {% set classe_erreur = errors|length > 0 ? ' border-statut-hors-service' : ' border-line' %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' mt-1.5 block w-full rounded-md border px-3 py-2 text-sm placeholder:text-slate-400' ~ classe_erreur)|trim}) %}
    {% if errors|length > 0 %}
        {% set attr = attr|merge({'aria-invalid': 'true', 'aria-describedby': id ~ '_erreurs'}) %}
    {% endif %}
    {{ parent() }}
    {% endif %}
{% endblock %}

{% block form_help %}
    {% if help is not empty %}
        <p id="{{ id }}_help" class="mt-1 text-xs text-ink-muted">{{ help }}</p>
    {% endif %}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul id="{{ id }}_erreurs" class="mt-1 text-sm text-statut-hors-service">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
