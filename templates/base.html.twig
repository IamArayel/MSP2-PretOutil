<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Accueil{% endblock %} · Prêt'Outil</title>
        <meta name="description" content="{% block description %}Prêt de matériel entre adhérents de l'association.{% endblock %}">
        <meta name="theme-color" content="#1b6e91">
        <link rel="icon" href="{{ asset('images/logo-icone.svg') }}" type="image/svg+xml">
        <link rel="icon" href="{{ asset('images/favicon-32.png') }}" type="image/png" sizes="32x32">
        <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
        {# Police de la charte chargée dès l'en-tête : pas de changement de police visible au chargement #}
        <link rel="preload" href="{{ asset('fonts/nunito-variable.woff2') }}" as="font" type="font/woff2" crossorigin>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app', {nonce: csp_nonce()}) }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph" nonce="{{ csp_nonce() }}"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module" nonce="{{ csp_nonce() }}"></script>
        {% endif %}
    </head>
    <body class="flex min-h-screen flex-col">
        <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2">
            Aller au contenu
        </a>

        {{ include('_partials/navbar.html.twig') }}

        <main id="contenu" class="mx-auto w-full max-w-7xl flex-1 px-4 py-10 sm:px-8">
            {% for message in app.flashes('succes') %}
                <div class="mx-auto mb-6 max-w-md rounded-md border border-green-200 bg-statut-disponible-bg px-4 py-3 text-sm text-statut-disponible" role="status">
                    {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('avertissement') %}
                <div class="mx-auto mb-6 max-w-3xl rounded-md border border-amber-200 bg-statut-sorti-bg px-4 py-3 text-sm text-statut-sorti" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('erreur') %}
                <div class="mx-auto mb-6 max-w-md rounded-md border border-red-200 bg-statut-hors-service-bg px-4 py-3 text-sm text-statut-hors-service" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {{ include('_partials/pied_de_page.html.twig') }}
    </body>
</html>
