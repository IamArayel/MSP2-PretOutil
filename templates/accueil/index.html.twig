{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <section class="max-w-2xl">
        <h1 class="text-3xl font-bold">Empruntez le matériel de l'association</h1>
        <p class="mt-3 text-ink-muted">
            Outillage, matériel de camping, audiovisuel : consultez le catalogue,
            vérifiez les disponibilités et réservez en ligne.
        </p>
        <a href="#" class="mt-6 inline-block rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-hover">
            Voir le catalogue
        </a>
    </section>

    <section class="mt-12" aria-labelledby="statuts-titre">
        <h2 id="statuts-titre" class="text-sm font-semibold text-ink-muted">Statuts des objets</h2>
        <ul class="mt-3 flex flex-wrap gap-2 text-xs font-medium">
            <li class="rounded-full bg-statut-disponible-bg px-2.5 py-1 text-statut-disponible">Disponible</li>
            <li class="rounded-full bg-statut-reserve-bg px-2.5 py-1 text-statut-reserve">Réservé</li>
            <li class="rounded-full bg-statut-sorti-bg px-2.5 py-1 text-statut-sorti">Sorti</li>
            <li class="rounded-full bg-statut-hors-service-bg px-2.5 py-1 text-statut-hors-service">Hors service</li>
        </ul>
    </section>
{% endblock %}
