{#
    500 : erreur du serveur. Page autonome, sans la barre de navigation : elle doit pouvoir
    s'afficher même si la base de données ne répond pas (la navigation lit le compte connecté).
    Aucun détail technique : il est enregistré dans les logs du serveur.
#}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Erreur du serveur · Prêt'Outil</title>
        <meta name="robots" content="noindex">
        <link rel="icon" href="{{ asset('images/logo-icone.svg') }}" type="image/svg+xml">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    </head>
    <body class="flex min-h-screen flex-col">
        <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2 focus:font-semibold">
            Aller au contenu
        </a>
        <header class="border-b border-line bg-surface">
            <div class="bandeau-logo" aria-hidden="true"></div>
            <div class="mx-auto flex max-w-7xl items-center px-4 py-4 sm:px-8">
                <a href="{{ path('app_accueil') }}" class="flex items-center gap-2 text-xl font-extrabold">
                    <img src="{{ asset('images/logo-icone.svg') }}" alt="" width="40" height="40" class="size-10">
                    <span><span class="text-primary">Prêt'</span><span class="text-danger">Outil</span></span>
                </a>
            </div>
        </header>
        <main id="contenu" class="mx-auto w-full max-w-7xl flex-1 px-4 py-10 sm:px-8">
            <section class="panneau mx-auto mt-6 flex max-w-2xl flex-col items-center gap-5 rounded-2xl px-6 py-12 text-center sm:px-12">
                <div class="w-40 animate-rebond" aria-hidden="true">
                    {{ include('bundles/TwigBundle/Exception/_illustration.html.twig', {motif: 'cle'}) }}
                </div>
                <p class="badge badge-neutre">Erreur {{ status_code }}</p>
                <h1 class="titre-page">Un problème est survenu de notre côté</h1>
                <p class="max-w-md text-ink-muted">
                    Le site n'a pas pu traiter votre demande. Vos données ne sont pas perdues :
                    réessayez dans quelques minutes.
                </p>
                <a href="{{ path('app_accueil') }}" class="bouton bouton-primaire mt-2">Retour à l'accueil</a>
            </section>
        </main>
    </body>
</html>
