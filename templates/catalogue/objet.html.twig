{% extends 'base.html.twig' %}

{% set objet = fiche.objet %}

{% block title %}{{ objet.nom }}{% endblock %}
{% block description %}{{ objet.description|length > 150 ? objet.description|slice(0, 149) ~ '…' : objet.description }}{% endblock %}

{% block body %}
    <nav aria-label="Fil d'Ariane" class="text-sm text-ink-muted">
        <ol class="flex flex-wrap gap-2">
            <li><a href="{{ path('app_catalogue') }}" class="hover:text-primary">Catalogue</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="{{ path('app_catalogue', {categorie: objet.categorie.id}) }}" class="hover:text-primary">{{ objet.categorie.libelle }}</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-ink">{{ objet.nom }}</li>
        </ol>
    </nav>

    <div class="mt-6 grid gap-8 lg:grid-cols-3">
        <article class="rounded-lg border border-line bg-surface p-6 lg:col-span-2">
            {{ include('catalogue/_photo.html.twig', {objet: objet, chargement: 'eager', classes: 'mb-6 rounded-md sm:max-w-md'}) }}
            <div class="flex items-center gap-3">
                <span class="text-sm text-ink-muted">{{ objet.categorie.libelle }}</span>
                {{ include('catalogue/_badge_statut.html.twig', {statut: fiche.statut}) }}
            </div>
            <h1 class="mt-3 text-3xl font-bold">{{ objet.nom }}</h1>
            <p class="mt-4 text-ink-muted">{{ objet.description }}</p>

            {% if objet.caracteristiques %}
                <h2 class="mt-6 font-semibold">Caractéristiques</h2>
                {% set lignes = objet.caracteristiques|split("\n")|map(l => l|trim)|filter(l => l is not empty) %}
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
                    {% for ligne in lignes %}
                        <li>{{ ligne }}</li>
                    {% endfor %}
                </ul>
            {% endif %}

            <h2 class="mt-6 font-semibold">Indisponibilités à venir</h2>
            {% if fiche.periodesReservees is empty %}
                <p class="mt-2 text-sm text-ink-muted">Aucune réservation à venir.</p>
            {% else %}
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
                    {% for periode in fiche.periodesReservees %}
                        <li>du {{ periode.dateDebut|date('d/m/Y') }} au {{ periode.dateFin|date('d/m/Y') }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </article>

        {# Réservation (US4), d'après la maquette E4 #}
        <aside class="self-start rounded-lg border border-line bg-surface p-6" aria-labelledby="reserver-titre">
            <h2 id="reserver-titre" class="text-xl font-semibold">Réserver cet objet</h2>

            {% set regles %}
                <p class="mt-4 text-xs text-ink-muted">
                    14 jours maximum · 3 réservations actives maximum · annulation possible jusqu'à la veille du début
                </p>
            {% endset %}

            {% if not fiche.estReservable %}
                <p class="mt-4 rounded-md border border-red-200 bg-statut-hors-service-bg px-4 py-3 text-sm text-statut-hors-service">
                    Cet objet est hors service : il ne peut pas être réservé pour le moment.
                </p>
                {{ regles }}
            {% elseif not is_granted('ROLE_USER') %}
                <p class="mt-4 text-sm text-ink-muted">Connectez-vous pour réserver cet objet.</p>
                <div class="mt-4 flex flex-col gap-3">
                    <a href="{{ path('app_connexion') }}" class="rounded-md bg-primary px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-primary-hover">Se connecter</a>
                    <a href="{{ path('app_inscription') }}" class="rounded-md border border-line bg-surface px-4 py-2.5 text-center text-sm font-semibold text-ink hover:bg-page">Créer un compte</a>
                </div>
                {{ regles }}
            {% else %}
                {# data-disponibilites-url : vérification des dates par l'API (US11, assets/disponibilites.js) #}
                {{ form_start(reservation, {attr: {class: 'mt-4', novalidate: 'novalidate', 'data-disponibilites-url': path('api_objet_disponibilites', {id: objet.id})}}) }}
                    {{ form_row(reservation.debut) }}
                    {{ form_row(reservation.fin) }}

                    {# Réponse de l'API, annoncée aux lecteurs d'écran : la zone reste dans la page, seul son contenu change #}
                    <div data-disponibilites-resultat role="status" aria-live="polite"></div>

                    {# Refus d'une règle de gestion (ReservationService), affiché tel quel #}
                    {% for erreur in reservation.vars.errors %}
                        <p class="mb-4 rounded-md border border-red-200 bg-statut-hors-service-bg px-4 py-3 text-sm text-statut-hors-service" role="alert">
                            {{ erreur.message }}
                        </p>
                    {% endfor %}

                    {{ regles }}

                    <button type="submit" class="mt-4 w-full rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-hover">
                        Confirmer la réservation
                    </button>
                {{ form_end(reservation) }}
            {% endif %}
        </aside>
    </div>
{% endblock %}
