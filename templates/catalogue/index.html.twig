{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}
    {% set page = catalogue.page %}

    {% embed '_partials/entete_page.html.twig' with {titre: 'Catalogue'} %}
        {% block sous_titre %}
            {# Zone remplacée par la recherche à la volée ; son texte est annoncé (assets/recherche.js) #}
            <p id="total-catalogue" class="sous-titre-page" data-recherche-zone data-recherche-annonce>
                {% if criteres.aUnePeriode %}
                    {{ page.total }} objet{{ page.total > 1 ? 's' }} disponible{{ page.total > 1 ? 's' }}
                    du {{ criteres.debut|date('d/m/Y') }} au {{ criteres.fin|date('d/m/Y') }}
                {% else %}
                    {{ page.total }} objet{{ page.total > 1 ? 's' }} à emprunter
                {% endif %}
                {% if criteres.recherche %}pour « {{ criteres.recherche }} »{% endif %}
            </p>
        {% endblock %}
    {% endembed %}

    {# Recherche (#109) et filtres (US3) : envoyés en GET, conservés dans les liens de pagination #}
    {{ form_start(filtres, {action: path('app_catalogue'), attr: {class: 'panneau mt-6 p-5', 'aria-label': 'Rechercher dans le catalogue', role: 'search'}}) }}
        {{ include('_partials/champ_recherche.html.twig', {champ: filtres.q}) }}
        <div class="mt-4 flex flex-wrap items-start gap-4">
            <div class="w-full sm:w-64">
                {{ form_label(filtres.categorie) }}
                {{ form_widget(filtres.categorie) }}
                {{ form_errors(filtres.categorie) }}
            </div>
            <div class="w-full sm:w-48">
                {{ form_label(filtres.debut) }}
                {{ form_widget(filtres.debut, {attr: {min: 'now'|date('Y-m-d')}}) }}
                {{ form_errors(filtres.debut) }}
            </div>
            <div class="w-full sm:w-48">
                {{ form_label(filtres.fin) }}
                {{ form_widget(filtres.fin, {attr: {min: 'now'|date('Y-m-d')}}) }}
                {{ form_errors(filtres.fin) }}
            </div>
            <div class="flex gap-3 sm:mt-6.5">
                <button type="submit" class="bouton bouton-primaire">Filtrer</button>
                <a href="{{ path('app_catalogue') }}" class="bouton bouton-secondaire">Réinitialiser</a>
            </div>
        </div>
    {{ form_end(filtres, {render_rest: false}) }}

    <div id="resultats-catalogue" data-recherche-zone>
    {% if page.elements is empty %}
        {{ include('_partials/etat_vide.html.twig', {
            message: 'Aucun objet ne correspond à ces critères. Essayez un autre nom, une autre catégorie ou d\'autres dates.',
            lien: {url: path('app_catalogue'), texte: 'Voir tout le catalogue'},
        }) }}
    {% else %}
        <ul class="grille-cartes mt-6">
            {% for objet in page.elements %}
                {{ include('_partials/carte_objet.html.twig', {objet: objet, statut: catalogue.statut(objet)}) }}
            {% endfor %}
        </ul>

        {{ include('_partials/pagination.html.twig', {route: 'app_catalogue', parametres: app.request.query.all}) }}
    {% endif %}
    </div>
{% endblock %}
