{#
    Badge du statut du jour d'un objet (App\Enum\StatutDuJour), composant badge de la charte.
    Variable attendue : statut
    Noms de classes écrits en entier : Tailwind ne génère que les classes qu'il lit dans les gabarits.
#}
{% set variantes = {
    disponible: 'badge-disponible',
    reserve: 'badge-reserve',
    sorti: 'badge-sorti',
    hors_service: 'badge-hors-service',
} %}
<span class="badge {{ variantes[statut.value] }}">{{ statut.libelle }}</span>
