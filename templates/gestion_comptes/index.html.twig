{% extends 'base.html.twig' %}

{% block title %}Gestion des comptes{% endblock %}

{# E8 non maquetté : composants communs à E6-E9 (assets/styles/app.css) #}
{% block body %}
    {{ include('_partials/entete_page.html.twig', {
        titre: 'Gestion des comptes',
        sous_titre: page.total ~ ' compte' ~ (page.total > 1 ? 's') ~ ' · chaque changement est enregistré dans le journal d\'audit',
    }) }}

    {% set badges_role = {
        adherent: 'badge-neutre',
        gestionnaire: 'badge-accent',
        administrateur: 'badge-reserve',
    } %}

    <div class="cadre-tableau mt-6" role="region" aria-label="Comptes de l'association" tabindex="0">
        <table class="tableau min-w-5xl">
            <caption class="sr-only">Comptes de l'association, page {{ page.numero }} sur {{ max(page.nombreDePages, 1) }}</caption>
            <thead class="tableau-entete">
                <tr>
                    <th scope="col" class="cellule-entete">Nom</th>
                    <th scope="col" class="cellule-entete">Email</th>
                    <th scope="col" class="cellule-entete">Rôle</th>
                    <th scope="col" class="cellule-entete">Compte</th>
                    <th scope="col" class="cellule-entete">Dernière activité</th>
                    <th scope="col" class="cellule-entete text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-line">
                {% for compte in page.elements %}
                    {% set role = role_de[compte.id] %}
                    {% set nom = compte.prenom ~ ' ' ~ compte.nom %}
                    {% set soi_meme = compte.id == app.user.id %}
                    <tr class="{{ compte.actif ? '' : 'bg-page text-ink-muted' }}">
                        <th scope="row" class="cellule font-normal">{{ nom }}{% if soi_meme %} <span class="font-normal text-ink-muted">(vous)</span>{% endif %}</th>
                        <td class="cellule">{{ compte.email }}</td>
                        <td class="cellule">
                            <span class="badge {{ badges_role[role.value] }}">{{ role.libelle }}</span>
                        </td>
                        <td class="cellule">{% if compte.actif %}Actif{% else %}<span class="badge badge-neutre">Désactivé</span>{% endif %}</td>
                        <td class="cellule whitespace-nowrap">{{ compte.derniereActiviteLe ? compte.derniereActiviteLe|date('d/m/Y') : 'Aucune' }}</td>
                        <td class="cellule">
                            {# Un administrateur n'agit pas sur son propre compte (CompteService) #}
                            {% if not soi_meme %}
                                <div class="flex flex-wrap items-center justify-end gap-2">
                                    <form method="post" action="{{ path('app_gestion_comptes_role', {id: compte.id}) }}" class="flex items-center gap-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token('role-compte-' ~ compte.id) }}">
                                        <input type="hidden" name="page" value="{{ page.numero }}">
                                        <label for="role-{{ compte.id }}" class="sr-only">Rôle de {{ nom }}</label>
                                        <select id="role-{{ compte.id }}" name="role" class="liste-choix">
                                            {% for choix in roles %}
                                                <option value="{{ choix.value }}"{% if choix == role %} selected{% endif %}>{{ choix.libelle }}</option>
                                            {% endfor %}
                                        </select>
                                        <button type="submit" class="bouton-ligne bouton-secondaire" aria-label="Changer le rôle de {{ nom }}">Changer</button>
                                    </form>

                                    {% if compte.actif %}
                                        <form method="post" action="{{ path('app_gestion_comptes_desactiver', {id: compte.id}) }}"
                                              data-confirmation="Désactiver le compte de {{ nom }} ? Sa session en cours sera fermée.">
                                            <input type="hidden" name="_token" value="{{ csrf_token('desactiver-compte-' ~ compte.id) }}">
                                            <input type="hidden" name="page" value="{{ page.numero }}">
                                            <button type="submit" class="bouton-ligne bouton-danger"
                                                    aria-label="Désactiver le compte de {{ nom }}">Désactiver</button>
                                        </form>
                                    {% else %}
                                        <form method="post" action="{{ path('app_gestion_comptes_reactiver', {id: compte.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('reactiver-compte-' ~ compte.id) }}">
                                            <input type="hidden" name="page" value="{{ page.numero }}">
                                            <button type="submit" class="bouton-ligne bouton-secondaire" aria-label="Réactiver le compte de {{ nom }}">Réactiver</button>
                                        </form>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="cellule-vide">Aucun compte.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {{ include('_partials/pagination.html.twig', {route: 'app_gestion_comptes'}) }}
{% endblock %}
