{#
    Message à l'utilisateur : flash après une action, refus, information.
    Paramètres : type ('succes', 'erreur', 'avertissement', 'information'), texte, classes (facultatif).
    Succès et information sont annoncés poliment (role="status") ; erreur et avertissement
    interrompent la lecture (role="alert"). L'icône est décorative, le texte suffit.
#}
{% set type = type ?? 'information' %}
{% set role = type in ['erreur', 'avertissement'] ? 'alert' : 'status' %}
{# Noms de classes écrits en entier : Tailwind ne génère que les classes qu'il lit dans les gabarits. #}
{% set variantes = {
    succes: 'message-succes',
    erreur: 'message-erreur',
    avertissement: 'message-avertissement',
    information: 'message-information',
} %}
<div class="message {{ variantes[type] }} {{ classes ?? '' }}" role="{{ role }}">
    <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
        {% if type == 'succes' %}
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.86-9.86a.75.75 0 0 0-1.22-.88l-3.24 4.5-1.65-1.65a.75.75 0 1 0-1.06 1.06l2.27 2.27a.75.75 0 0 0 1.14-.09l3.76-5.21Z" clip-rule="evenodd"/>
        {% elseif type == 'erreur' %}
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd"/>
        {% elseif type == 'avertissement' %}
            <path fill-rule="evenodd" d="M8.49 2.86c.66-1.15 2.36-1.15 3.02 0l6.28 10.98c.65 1.14-.17 2.56-1.5 2.56H3.71c-1.33 0-2.15-1.42-1.5-2.56L8.49 2.86ZM10 6.5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 6.5Zm0 7.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/>
        {% else %}
            <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.25v2.25a.75.75 0 0 0 1.5 0V9.75A.75.75 0 0 0 10 9H9Z" clip-rule="evenodd"/>
        {% endif %}
    </svg>
    <p>{{ texte }}</p>
</div>
