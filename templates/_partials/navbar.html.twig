{#
    Barre de navigation, d'après les maquettes Figma (E1 pour le visiteur, E3 pour l'adhérent).
    Les liens affichés dépendent des rôles (role_hierarchy : un admin voit tout).
#}
<header class="border-b border-line bg-surface">
    <nav class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 gap-y-3 px-4 py-4 sm:px-8" aria-label="Navigation principale">
        <a href="{{ path('app_accueil') }}" class="text-xl font-bold text-primary">Prêt'Outil</a>

        <ul class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm text-ink-muted">
            {% set sur_catalogue = (app.request.attributes.get('_route') ?? '') starts with 'app_catalogue' %}
            <li><a href="{{ path('app_catalogue') }}" class="hover:text-primary{{ sur_catalogue ? ' font-semibold text-primary' }}"{% if sur_catalogue %} aria-current="page"{% endif %}>Catalogue</a></li>
            {% if is_granted('ROLE_USER') %}
                {% set sur_mes_reservations = (app.request.attributes.get('_route') ?? '') starts with 'app_mes_reservations' %}
                <li><a href="{{ path('app_mes_reservations') }}" class="hover:text-primary{{ sur_mes_reservations ? ' font-semibold text-primary' }}"{% if sur_mes_reservations %} aria-current="page"{% endif %}>Mes réservations</a></li>
            {% endif %}
            {% if is_granted('ROLE_MANAGER') %}
                {% set sur_sorties_retours = (app.request.attributes.get('_route') ?? '') starts with 'app_sorties_retours' %}
                <li><a href="{{ path('app_sorties_retours') }}" class="hover:text-primary{{ sur_sorties_retours ? ' font-semibold text-primary' }}"{% if sur_sorties_retours %} aria-current="page"{% endif %}>Sorties et retours</a></li>
                {% set sur_gestion_catalogue = (app.request.attributes.get('_route') ?? '') starts with 'app_gestion_catalogue' %}
                <li><a href="{{ path('app_gestion_catalogue') }}" class="hover:text-primary{{ sur_gestion_catalogue ? ' font-semibold text-primary' }}"{% if sur_gestion_catalogue %} aria-current="page"{% endif %}>Gestion du catalogue</a></li>
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
                {% set sur_comptes = (app.request.attributes.get('_route') ?? '') starts with 'app_gestion_comptes' %}
                <li><a href="{{ path('app_gestion_comptes') }}" class="hover:text-primary{{ sur_comptes ? ' font-semibold text-primary' }}"{% if sur_comptes %} aria-current="page"{% endif %}>Gestion des comptes</a></li>
                {% set sur_journal = (app.request.attributes.get('_route') ?? '') == 'app_journal_audit' %}
                <li><a href="{{ path('app_journal_audit') }}" class="hover:text-primary{{ sur_journal ? ' font-semibold text-primary' }}"{% if sur_journal %} aria-current="page"{% endif %}>Journal d'audit</a></li>
            {% endif %}
        </ul>

        <div class="ml-auto flex items-center gap-3 text-sm">
            {% if app.user %}
                <span class="text-ink-muted">{{ app.user.prenom }} {{ app.user.nom }}</span>
                <a href="{{ logout_path() }}" class="rounded-md border border-line bg-surface px-4 py-2 font-semibold text-ink hover:bg-page">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_inscription') }}" class="rounded-md border border-line bg-surface px-4 py-2 font-semibold text-ink hover:bg-page">Créer un compte</a>
                <a href="{{ path('app_connexion') }}" class="rounded-md bg-primary px-4 py-2 font-semibold text-white hover:bg-primary-hover">Se connecter</a>
            {% endif %}
        </div>
    </nav>
</header>
