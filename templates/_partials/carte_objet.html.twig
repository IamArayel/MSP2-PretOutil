{#
    Carte d'un objet du catalogue (E3) : photo ou icône, catégorie, badge de statut, nom,
    description et lien vers la fiche. La carte se soulève au survol ou quand son lien a le focus.
    Paramètres : objet, statut (App\Enum\StatutDuJour).
#}
<li class="carte group">
    <div class="overflow-hidden">
        {{ include('catalogue/_photo.html.twig', {objet: objet, classes: 'transition-transform duration-300 ease-out group-hover:scale-105'}) }}
    </div>
    <div class="flex flex-1 flex-col p-5">
        <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-semibold tracking-wide text-ink-muted uppercase">{{ objet.categorie.libelle }}</span>
            {{ include('catalogue/_badge_statut.html.twig', {statut: statut}) }}
        </div>
        <h2 class="mt-3 text-lg font-bold">{{ objet.nom }}</h2>
        <p class="mt-2 line-clamp-2 flex-1 text-sm text-ink-muted">{{ objet.description }}</p>
        <a href="{{ path('app_catalogue_objet', {id: objet.id}) }}"
           class="bouton-ligne bouton-secondaire mt-4 self-start group-hover:border-primary group-hover:text-primary"
           aria-label="Voir le détail : {{ objet.nom }}">
            Voir le détail
            <svg class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
        </a>
    </div>
</li>
