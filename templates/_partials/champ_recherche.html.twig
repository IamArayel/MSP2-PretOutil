{#
    Barre de recherche des écrans E3 et E7 (#109) : champ, bouton Rechercher et zone d'annonce.
    Paramètre : champ (ChampRechercheType).

    Sans JavaScript, le bouton envoie le formulaire. Avec, assets/recherche.js lance la recherche
    dès 3 lettres et remplace les zones [data-recherche-zone] ; le bouton reste pour le clavier
    et les lecteurs d'écran.
#}
<div class="flex flex-wrap items-end gap-4" data-recherche>
    <div class="w-full sm:w-64">
        {{ form_label(champ) }}
        {{ form_widget(champ) }}
    </div>
    <button type="submit" class="bouton bouton-primaire">Rechercher</button>
    {% if champ.vars.errors|length > 0 %}
        <div class="w-full">{{ form_errors(champ) }}</div>
    {% endif %}
    {# Nombre de résultats annoncé après une recherche à la volée (WCAG 4.1.3) #}
    <p class="sr-only" aria-live="polite" data-recherche-statut></p>
</div>
