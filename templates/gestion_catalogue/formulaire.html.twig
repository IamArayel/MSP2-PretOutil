{% extends 'base.html.twig' %}

{% set titre = objet ? 'Modifier « ' ~ objet.nom ~ ' »' : 'Ajouter un objet' %}

{% block title %}{{ titre }}{% endblock %}

{# Formulaire d'ajout et de modification (E7), même structure que E1 et E2 #}
{% block body %}
    <div class="mx-auto max-w-2xl">
        <a href="{{ path('app_gestion_catalogue') }}" class="lien text-sm">← Gestion du catalogue</a>

        <div class="panneau mt-4 p-6 sm:p-8">
            <h1 class="titre-page text-2xl">{{ titre }}</h1>
            {% if objet and not objet.actif %}
                <p class="mt-2"><span class="badge badge-neutre">Retiré du catalogue</span></p>
            {% endif %}

            <p class="mt-2 text-sm text-ink-muted">Tous les champs sont obligatoires, sauf mention contraire.</p>

            {{ form_start(form, {attr: {class: 'mt-4', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                <div class="grid gap-x-4 sm:grid-cols-2">
                    {{ form_row(form.categorie) }}
                    {{ form_row(form.etat) }}
                </div>
                {{ form_row(form.nom) }}
                {{ form_row(form.description) }}
                {{ form_row(form.caracteristiques) }}

                {# Photo (#106) : aperçu de la photo actuelle, envoi d'une nouvelle, case pour la retirer #}
                {% if objet and objet.image %}
                    <figure class="mb-4">
                        {{ include('catalogue/_photo.html.twig', {objet: objet, classes: 'max-w-60 rounded-lg', chargement: 'eager'}) }}
                        <figcaption class="mt-1 text-xs text-ink-muted">Photo actuelle</figcaption>
                    </figure>
                {% endif %}
                {{ form_row(form.photo) }}
                {% if form.supprimerPhoto is defined %}
                    {{ form_row(form.supprimerPhoto) }}
                {% endif %}

                <div class="mt-2 flex gap-3">
                    <button type="submit" class="bouton bouton-primaire">
                        {{ objet ? 'Enregistrer les modifications' : 'Ajouter au catalogue' }}
                    </button>
                    <a href="{{ path('app_gestion_catalogue') }}" class="bouton bouton-secondaire">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
