{% extends 'base.html.twig' %}

{% set titre = objet ? 'Modifier « ' ~ objet.nom ~ ' »' : 'Ajouter un objet' %}

{% block title %}{{ titre }}{% endblock %}

{# Formulaire d'ajout et de modification (E7), même structure que E1 et E2 #}
{% block body %}
    <div class="mx-auto max-w-2xl">
        <a href="{{ path('app_gestion_catalogue') }}" class="text-sm font-semibold text-primary hover:underline">← Gestion du catalogue</a>

        <div class="mt-4 rounded-lg border border-line bg-surface p-6">
            <h1 class="text-2xl font-bold">{{ titre }}</h1>
            {% if objet and not objet.actif %}
                <p class="mt-1 text-sm text-ink-muted">Cet objet est retiré du catalogue.</p>
            {% endif %}

            <p class="mt-2 text-sm text-ink-muted">Tous les champs sont obligatoires, sauf mention contraire.</p>

            {{ form_start(form, {attr: {class: 'mt-4', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                <div class="grid gap-x-4 sm:grid-cols-2">
                    {{ form_row(form.categorie) }}
                    {{ form_row(form.etat) }}
                </div>
                {{ form_row(form.nom) }}
                {{ form_row(form.description) }}
                {{ form_row(form.caracteristiques) }}

                <div class="mt-2 flex gap-3">
                    <button type="submit" class="rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-hover">
                        {{ objet ? 'Enregistrer les modifications' : 'Ajouter au catalogue' }}
                    </button>
                    <a href="{{ path('app_gestion_catalogue') }}" class="rounded-md border border-line bg-surface px-4 py-2.5 text-sm font-semibold text-ink hover:bg-page">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
