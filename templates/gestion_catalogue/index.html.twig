{% extends 'base.html.twig' %}

{% block title %}Gestion du catalogue{% endblock %}

{# E7 non maquetté : composants communs à E6-E9 (assets/styles/app.css) #}
{% block body %}
    {% embed '_partials/entete_page.html.twig' with {titre: 'Gestion du catalogue'} %}
        {% block sous_titre %}
            {# Zone remplacée par la recherche à la volée ; son texte est annoncé (assets/recherche.js) #}
            <p id="total-gestion-catalogue" class="sous-titre-page" data-recherche-zone data-recherche-annonce>
                {{ page.total }} objet{{ page.total > 1 ? 's' }}
                {%- if texte_recherche %} pour « {{ texte_recherche }} »{% endif %}, actifs et retirés du catalogue
            </p>
        {% endblock %}
        {% block actions %}
            <a href="{{ path('app_gestion_catalogue_nouveau') }}" class="bouton bouton-primaire">Ajouter un objet</a>
        {% endblock %}
    {% endembed %}

    {% set badges_etat = {
        bon: 'badge-disponible',
        abime: 'badge-sorti',
        hors_service: 'badge-hors-service',
    } %}

    {# Recherche par nom (#109), y compris parmi les objets retirés du catalogue #}
    {{ form_start(recherche, {action: path('app_gestion_catalogue'), attr: {class: 'panneau mt-6 p-5', 'aria-label': 'Rechercher un objet du catalogue', role: 'search'}}) }}
        {{ include('_partials/champ_recherche.html.twig', {champ: recherche.q}) }}
    {{ form_end(recherche, {render_rest: false}) }}

    <div id="resultats-gestion-catalogue" data-recherche-zone>
    <div class="cadre-tableau mt-6" role="region" aria-label="Objets du catalogue" tabindex="0">
        <table class="tableau">
            <caption class="sr-only">Objets du catalogue, page {{ page.numero }} sur {{ max(page.nombreDePages, 1) }}</caption>
            <thead class="tableau-entete">
                <tr>
                    <th scope="col" class="cellule-entete">Objet</th>
                    <th scope="col" class="cellule-entete">Catégorie</th>
                    <th scope="col" class="cellule-entete">État</th>
                    <th scope="col" class="cellule-entete">Catalogue</th>
                    <th scope="col" class="cellule-entete text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-line">
                {% for objet in page.elements %}
                    <tr class="{{ objet.actif ? '' : 'bg-page text-ink-muted' }}">
                        <th scope="row" class="cellule font-normal">{{ objet.nom }}</th>
                        <td class="cellule">{{ objet.categorie.libelle }}</td>
                        <td class="cellule">
                            <span class="badge {{ badges_etat[objet.etat.value] }}">{{ objet.etat.libelle }}</span>
                        </td>
                        <td class="cellule">{% if objet.actif %}Actif{% else %}<span class="badge badge-neutre">Retiré</span>{% endif %}</td>
                        <td class="cellule">
                            <div class="flex flex-wrap justify-end gap-2">
                                <a href="{{ path('app_gestion_catalogue_modifier', {id: objet.id}) }}"
                                   class="bouton-ligne bouton-secondaire"
                                   aria-label="Modifier : {{ objet.nom }}">Modifier</a>

                                {% if objet.actif %}
                                    <form method="post" action="{{ path('app_gestion_catalogue_desactiver', {id: objet.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('desactiver-objet-' ~ objet.id) }}">
                                        {# Nom accessible qui commence par le texte visible (WCAG 2.5.3) #}
                                        <button type="submit" class="bouton-ligne bouton-secondaire"
                                                aria-label="Désactiver : {{ objet.nom }} (retirer du catalogue)">Désactiver</button>
                                    </form>
                                {% else %}
                                    {# Remise au catalogue (#111) : sans confirmation, « Désactiver » l'annule en un clic #}
                                    <form method="post" action="{{ path('app_gestion_catalogue_reactiver', {id: objet.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reactiver-objet-' ~ objet.id) }}">
                                        <button type="submit" class="bouton-ligne bouton-secondaire"
                                                aria-label="Réactiver : {{ objet.nom }} (remettre au catalogue)">Réactiver</button>
                                    </form>
                                {% endif %}

                                {# Suppression physique : seulement pour un objet jamais réservé (US6) #}
                                {% if deja_reserves[objet.id] is not defined %}
                                    <form method="post" action="{{ path('app_gestion_catalogue_supprimer', {id: objet.id}) }}"
                                          data-confirmation="Supprimer définitivement « {{ objet.nom }} » ?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer-objet-' ~ objet.id) }}">
                                        <button type="submit" class="bouton-ligne bouton-danger"
                                                aria-label="Supprimer définitivement : {{ objet.nom }}">Supprimer</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="cellule-vide">
                        {% if texte_recherche %}Aucun objet ne correspond à « {{ texte_recherche }} ».{% else %}Aucun objet dans le catalogue.{% endif %}
                    </td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {{ include('_partials/pagination.html.twig', {
        route: 'app_gestion_catalogue',
        parametres: texte_recherche ? {q: texte_recherche} : {},
    }) }}
    </div>
{% endblock %}
