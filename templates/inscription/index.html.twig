{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{# E2 non maquetté : même structure que E1 (enchainement-ecrans.md) #}
{% block body %}
    <div class="panneau mx-auto mt-6 max-w-md rounded-2xl p-6 sm:p-8">
        <img src="{{ asset('images/logo-icone.svg') }}" alt="" width="56" height="56" class="size-14 animate-rebond">
        <h1 class="titre-page mt-4">Créer un compte</h1>
        <p class="mt-1 text-sm text-ink-muted">Inscrivez-vous pour réserver du matériel de l'association.</p>
        <p class="mt-2 text-sm text-ink-muted">Tous les champs sont obligatoires, sauf mention contraire.</p>

        {{ form_start(form, {attr: {class: 'mt-4', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            <div class="grid gap-x-4 sm:grid-cols-2">
                {{ form_row(form.prenom) }}
                {{ form_row(form.nom) }}
            </div>
            {{ form_row(form.email) }}
            {{ form_row(form.telephone) }}
            {{ form_row(form.motDePasse) }}

            <button type="submit" class="bouton bouton-primaire mt-2 w-full">
                Créer mon compte
            </button>
        {{ form_end(form) }}

        <p class="mt-4 text-sm text-ink-muted">
            Déjà inscrit ? <a href="{{ path('app_connexion') }}" class="lien">Se connecter</a>
        </p>
    </div>
{% endblock %}
