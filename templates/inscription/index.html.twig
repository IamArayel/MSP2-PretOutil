{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{# E2 non maquetté : même structure que E1 (enchainement-ecrans.md) #}
{% block body %}
    <div class="mx-auto mt-6 max-w-md rounded-lg border border-line bg-surface p-6">
        <h1 class="text-3xl font-bold">Créer un compte</h1>
        <p class="mt-1 text-sm text-ink-muted">Inscrivez-vous pour réserver du matériel de l'association.</p>
        <p class="mt-2 text-sm text-ink-muted">Tous les champs sont obligatoires, sauf mention contraire.</p>

        {{ form_start(form, {attr: {class: 'mt-4', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            <div class="grid gap-x-4 sm:grid-cols-2">
                {{ form_row(form.prenom) }}
                {{ form_row(form.nom) }}
            </div>
            {{ form_row(form.email) }}
            {{ form_row(form.telephone) }}
            {{ form_row(form.motDePasse) }}

            <button type="submit" class="mt-2 w-full rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-hover">
                Créer mon compte
            </button>
        {{ form_end(form) }}

        <p class="mt-4 text-sm text-ink-muted">
            Déjà inscrit ? <a href="{{ path('app_connexion') }}" class="font-semibold text-primary hover:underline">Se connecter</a>
        </p>
    </div>
{% endblock %}
