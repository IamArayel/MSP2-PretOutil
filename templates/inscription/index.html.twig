{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{# E2 non maquetté : même structure que E1 (enchainement-ecrans.md) #}
{% block body %}
    <div class="panneau mx-auto mt-6 max-w-md rounded-2xl p-6 sm:p-8">
        <img src="{{ asset('images/logo-icone.svg') }}" alt="" width="56" height="56" class="size-14 animate-rebond">
        <h1 class="titre-page mt-4">Créer un compte</h1>
        <p class="mt-1 text-sm text-ink-muted">Inscrivez-vous pour réserver du matériel de l'association.</p>
        <p class="mt-2 text-sm text-ink-muted">Tous les champs sont obligatoires, sauf mention contraire.</p>

        {{ form_start(form, {attr: {class: 'mt-4', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            <div class="grid gap-x-4 sm:grid-cols-2">
                {{ form_row(form.prenom) }}
                {{ form_row(form.nom) }}
            </div>
            {{ form_row(form.email) }}
            {{ form_row(form.telephone) }}
            {{ form_row(form.motDePasse) }}

            {# Acceptation des CGU (#106) : le libellé porte les liens, ouverts dans un nouvel onglet pour garder la saisie #}
            {% set cgu = form.accepteCgu %}
            {% set cgu_erreurs = cgu.vars.errors|length > 0 %}
            <div class="mb-4">
                <div class="flex items-start gap-3">
                    {{ form_widget(cgu, {attr: {class: 'mt-0.5 size-5 shrink-0 accent-primary'}|merge(cgu_erreurs ? {'aria-invalid': 'true', 'aria-describedby': cgu.vars.id ~ '_erreurs'} : {})}) }}
                    <label for="{{ cgu.vars.id }}" class="text-sm">
                        J'accepte les
                        <a href="{{ path('app_cgu') }}" class="lien" target="_blank">conditions générales d'utilisation<span class="sr-only"> (nouvel onglet)</span></a>
                        et j'ai lu la
                        <a href="{{ path('app_confidentialite') }}" class="lien" target="_blank">politique de confidentialité<span class="sr-only"> (nouvel onglet)</span></a>.
                    </label>
                </div>
                {{ form_errors(cgu) }}
            </div>

            <button type="submit" class="bouton bouton-primaire mt-2 w-full">
                Créer mon compte
            </button>
        {{ form_end(form) }}

        <p class="mt-4 text-sm text-ink-muted">
            Déjà inscrit ? <a href="{{ path('app_connexion') }}" class="lien">Se connecter</a>
        </p>
    </div>
{% endblock %}
