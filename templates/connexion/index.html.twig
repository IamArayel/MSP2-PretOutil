{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="panneau mx-auto mt-6 max-w-md rounded-2xl p-6 sm:p-8">
        <img src="{{ asset('images/logo-icone.svg') }}" alt="" width="56" height="56" class="size-14 animate-rebond">
        <h1 class="titre-page mt-4">Connexion</h1>
        <p class="mt-1 text-sm text-ink-muted">Accédez à votre espace pour réserver du matériel.</p>

        {% if erreur %}
            {{ include('_partials/message.html.twig', {type: 'erreur', texte: erreur, classes: 'mt-4'}) }}
        {% endif %}

        <form method="post" action="{{ path('app_connexion') }}" class="mt-4 space-y-4">
            <div>
                <label for="email" class="block text-sm font-medium">Email</label>
                <input type="email" id="email" name="email" value="{{ dernier_email }}"
                       autocomplete="email" required autofocus
                       placeholder="camille.martin@exemple.fr"
                       class="champ">
            </div>

            <div>
                <label for="mot_de_passe" class="block text-sm font-medium">Mot de passe</label>
                <input type="password" id="mot_de_passe" name="mot_de_passe"
                       autocomplete="current-password" required
                       class="champ">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="bouton bouton-primaire w-full">
                Se connecter
            </button>
        </form>

        <p class="mt-4 text-sm text-ink-muted">
            Pas encore de compte ? <a href="{{ path('app_inscription') }}" class="lien">Créer un compte</a>
        </p>
    </div>
{% endblock %}
