# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> pretoutil/docker ###
# Identifiants non secrets, lus par Docker Compose et par Symfony.
# Les mots de passe sont dans .env.local (non versionné), voir README > Installation.
POSTGRES_VERSION=16
POSTGRES_DB=pretoutil
POSTGRES_USER=pretoutil
MONGODB_VERSION=8.0
MONGODB_USER=pretoutil
###< pretoutil/docker ###

###> doctrine/doctrine-bundle ###
# Les mots de passe viennent de .env.local, transmis au conteneur php par Docker Compose (env_file).
# Application : compte aux droits minimaux. Migrations et fixtures : propriétaire du schéma.
DATABASE_URL="postgresql://pretoutil_app:${POSTGRES_APP_PASSWORD:-}@database:5432/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&charset=utf8"
DATABASE_OWNER_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD:-}@database:5432/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&charset=utf8"
###< doctrine/doctrine-bundle ###

###> doctrine/mongodb-odm-bundle ###
# Application : utilisateur pretoutil_app (rôle auditAppendOnly), déclaré dans la base pretoutil.
MONGODB_DB=pretoutil
MONGODB_URI="mongodb://pretoutil_app:${MONGODB_APP_PASSWORD:-}@mongodb:27017/${MONGODB_DB}?authSource=${MONGODB_DB}"
###< doctrine/mongodb-odm-bundle ###
